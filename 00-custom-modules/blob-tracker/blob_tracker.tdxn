  position: [4875, -120]
  dock: glsl_overlay
  dat_read_only: true
- name: glsl_overlay_pixel
  type: textDAT
  parameters:
    language: glsl
    extension: frag
  position: [4725, -120]
  dock: glsl_overlay
- name: script_labels_callbacks
  type: textDAT
  parameters:
    language: python
  position: [4400, -2920]
  dock: script_labels
- name: script_points_callbacks
  type: textDAT
  parameters:
    language: python
  position: [3200, -2120]
  dock: script_points
annotations:
- name: annotate1
  mode: annotate
  title: Input
  text: The video coming in. constant_nosignal shows black when nothing is wired to the module.
  position: [-70, -70]
  size: [1070, 330]
  color: [0.3, 0.4, 0.5]
- name: annotate2
  mode: annotate
  title: Detection
  text: 'A small, blurred copy of the video becomes a mask: bright, dark, moving or edge pixels above Threshold. feedback_prev holds the last frame for Motion.'
  position: [1130, -1270]
  size: [1870, 730]
  color: [0.45, 0.35, 0.25]
- name: annotate3
  mode: annotate
  title: Tracking
  text: script_points turns OpenCV blobs or corners, or MediaPipe landmarks, into tracked points with stable IDs, box sizes and links (one sample per slot). choptotop_points hands them to the shaders, out_points to the host, script_labels writes the label text.
  position: [2730, -2990]
  size: [1870, 1250]
  color: [0.3, 0.45, 0.3]
- name: annotate4
  mode: annotate
  title: Render
  text: glsl_overlay draws boxes, crosshairs and lines with trails; glsl_look treats the background and the inside of the boxes and lays the overlay on top; text_labels adds the labels. Show Mask switches to the detection view.
  position: [3930, -470]
  size: [3070, 1330]
  color: [0.5, 0.3, 0.45]
- name: annotate5
  mode: annotate
  title: Module
  text: Reset Tracking and Save Module.
  position: [-70, -1670]
  size: [270, 330]
  color: [0.35, 0.35, 0.35]
