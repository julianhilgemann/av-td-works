  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: composite_labels
  type: compositeTOP
  parameters:
    operand: over
  position: [5600, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - text_labels
  - glsl_look
- name: module_callbacks
  type: parameterexecuteDAT
  parameters:
    fromop: =parent()
    op: ..
    pars: Resettracking Savemodule
    valuechange: false
    builtin: false
  position: [0, -1600]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  tags:
  - tdxn_exclude:dat_content
- name: constant_nosignal
  type: constantTOP
  parameters:
    resolutionw: 1280
    resolutionh: 720
- name: glsl_overlay_info
