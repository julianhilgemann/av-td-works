  position: [3200, -2000]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - constant_tick
- name: constant_clear
  type: constantTOP
  parameters:
    alpha: 0
    resolutionw: 64
    resolutionh: 64
    format: rgba16float
  position: [4000, 600]
- name: glsl_look_info
