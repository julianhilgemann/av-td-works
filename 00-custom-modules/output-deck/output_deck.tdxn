format: tdxn
version: '2.2'
generator: Embody/6.2.72
td_build: 099.2025.32820
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  nullTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  textDAT:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    tags:
    - tdxn_exclude:dat_content
type: baseCOMP
custom_pars:
  Format:
  - name: Outputformat
    style: Menu
    label: Output Format
    default: input
    menuNames:
    - input
    - hd720
    - hd1080
    - uhd4k
    - phone
    - iphone
    - square
    - portrait45
    - custom
    menuLabels:
    - Same as Input
    - HD 720p (1280 x 720)
    - Full HD 1080p (1920 x 1080)
    - 4K UHD TV (3840 x 2160)
    - Phone 9:16 (1080 x 1920)
    - iPhone Full Screen (1179 x 2556)
    - Square (1080 x 1080)
    - Portrait 4:5 (1080 x 1350)
    - Custom Size
    help: The size of the shared and recorded picture. Same as Input keeps the picture's own size; the phone formats are portrait; Custom Size uses Custom Width and Custom Height.
  - name: Swapsize
    style: Toggle
    label: Swap Width and Height
    help: 'Turns the chosen format on its side: landscape becomes portrait (a TV hung upright) and portrait becomes landscape.'
  - name: Outputwidth
    style: Int
    label: Custom Width
    startSection: true
    default: 1920
    min: 16.0
    max: 8192.0
    clampMin: true
    clampMax: true
    normMin: 256.0
    normMax: 3840.0
    help: Output width in pixels when Output Format is Custom Size.
  - name: Outputheight
    style: Int
    label: Custom Height
    default: 1080
    min: 16.0
    max: 8192.0
    clampMin: true
    clampMax: true
    normMin: 256.0
    normMax: 3840.0
    help: Output height in pixels when Output Format is Custom Size.
  - name: Outputsize
    style: Str
    label: Output Size
    startSection: true
    readOnly: true
    help: The size being shared and recorded. A Non-Commercial licence limits the longest side to 1280 pixels, so a larger format is rendered smaller at the same shape; a Commercial or Pro licence renders the full size. Read only.
  Framing:
  - name: Picturefit
    style: Menu
    label: Picture Fit
    default: fit
    menuNames:
    - fit
    - fill
    - stretch
    - native
    menuLabels:
    - Fit Inside
    - Fill (crop)
    - Stretch
    - Native Size
    help: 'How the picture fills the output when their shapes differ: Fit Inside shows all of it with background around it, Fill covers the output and crops, Stretch distorts it to the output''s shape, Native Size keeps its own pixel size.'
  - name: Picturezoom
    style: Float
    label: Picture Zoom
    default: 1
    min: 0.1
    max: 4.0
    clampMin: true
    clampMax: true
    normMin: 0.25
    normMax: 2.0
    help: 'Scales the fitted picture: 1 is the fitted size, below 1 leaves more background around it.'
  - name: Pictureoffset
    style: XYZW
    label: Picture Position
    size: 2
    min: -1.0
    normMin: -1.0
    help: 'Moves the picture''s centre across the output: 0 0 is the middle, -1 the left (or bottom) edge, 1 the right (or top) edge.'
  - name: Softedge
    style: Float
    label: Soft Edge
    startSection: true
    default: 0.1
    max: 0.5
    clampMin: true
    clampMax: true
    normMax: 0.5
    help: Fades the picture's edges into the background over this share of its shorter side, so a picture smaller than the output blends in instead of ending in a hard border. Edges that touch the border of the output stay sharp. 0 is a hard edge.
  - name: Edgeshape
    style: Menu
    label: Edge Shape
    default: rect
    menuNames:
    - rect
    - oval
    menuLabels:
    - Rectangle
    - Oval
    help: 'The shape the soft edge follows: Rectangle fades the picture''s sides, Oval fades it into a round vignette.'
  - name: Background
    style: Menu
    startSection: true
    default: color
    menuNames:
    - color
    - blur
    - mirror
    - transparent
    menuLabels:
    - Solid Colour
    - Blurred Picture
    - Mirrored Picture
    - Transparent
    help: 'What fills the output around the picture: a solid colour, the picture itself blurred to cover the output, the picture mirrored outward from its edges, or nothing (transparent, for layering in OBS; a movie file has no transparency).'
  - name: Backgroundcolor
    style: RGBA
    label: Background Colour
    size: 3
    help: Colour of the background. With Blurred or Mirrored Picture it is mixed with the picture by Picture in Background.
  - name: Backgroundlevel
    style: Float
    label: Picture in Background
    default: 0.35
    clampMin: true
    clampMax: true
    help: 'How much of the blurred or mirrored picture shows in the background: 0 is the plain Background Colour, 1 the picture at full brightness.'
  - name: Blendmode
    style: Menu
    label: Blend
    default: over
    menuNames:
    - over
    - add
    - screen
    - lighten
    menuLabels:
    - Over
    - Add
    - Screen
    - Lighten
    help: 'How the picture sits on the background: Over covers it, Add and Screen let the background show through the picture''s dark parts (for glowing visuals on black), Lighten keeps the brighter of the two.'
  Share:
  - name: Share
    style: Toggle
    label: Send to OBS (Spout/Syphon)
    help: Shares the output as a Spout sender (Windows) or a Syphon server (macOS). In OBS, add a Spout2 Capture source (the obs-spout2-plugin) on Windows or a Syphon Client source on macOS, and pick Sender Name.
  - name: Sendername
    style: Str
    label: Sender Name
    default: TouchDesigner
    help: The name OBS and other apps see for this output.
  Record:
  - name: Record
    style: Toggle
    help: Records the output to a movie while on. Every take is a new file in the Recordings Folder, named after Recording Name (or the project) and the date and time it started.
  - name: Recordtiming
    style: Menu
    label: Timing
    default: exact
    menuNames:
    - exact
    - live
    menuLabels:
    - Frame-Exact
    - Live
    help: 'Frame-Exact puts every frame in the movie even when one takes longer than real time to render: TD''s Realtime flag is off while recording, so the movie''s picture and sound stay smooth while the speakers, a camera or a microphone fall out of step. Live records as it plays, and frames TD drops are repeated in the movie.'
  - name: Recordlength
    style: Float
    label: Stop After
    clampMin: true
    normMax: 600.0
    help: Stops the take after this many seconds of movie. 0 records until Record is turned off.
  - name: Recordcodec
    style: Menu
    label: Codec
    startSection: true
    default: h264
    menuNames:
    - h264
    - h265
    - mpeg4
    - prores
    - gif
    menuLabels:
    - H.264 (.mp4)
    - H.265 / HEVC (.mp4)
    - MPEG-4 (.mp4)
    - Apple ProRes (.mov)
    - GIF (.gif, no sound)
    help: H.264 plays everywhere and H.265 makes smaller files; both encode on an NVIDIA GPU and need a Commercial or Pro licence, so on a Non-Commercial licence they record as MPEG-4 instead. MPEG-4 writes .mp4 on any licence; Apple ProRes writes a large .mov for editing. GIF writes an animated .gif without sound, in TD's fixed colour palette; on Auto it is 480 pixels on its longest side at 20 fps.
  - name: Recordquality
    style: Menu
    label: Quality
    default: standard
    menuNames:
    - smallest
    - small
    - standard
    - high
    - max
    menuLabels:
    - Smallest File
    - Small
    - Standard
    - High
    - Very High
    help: 'How hard the movie is compressed: smaller files or better pictures. H.264 and H.265 get a bit rate of about 0.03, 0.05, 0.1, 0.2 or 0.35 bits per pixel at the record size and frame rate. MPEG-4 ignores bit rates and gets TD''s Quality Scale 0.15, 0.3, 0.45, 0.6 or 0.8 instead: about 4, 5.5, 9, 12 or 20 Mb/s at 1280 x 720 and 60 fps, depending on the picture. ProRes steps from 422 Proxy through LT, 422 and 422 HQ to 4444. GIF has no quality steps: Record Size and Frame Rate set its file size.'
  - name: Recordsize
    style: Menu
    label: Record Size
    default: auto
    menuNames:
    - auto
    - full
    - half
    - third
    - quarter
    menuLabels:
    - Auto (Output Size; GIF 480 px)
    - Output Size
    - 1/2 Size
    - 1/3 Size
    - 1/4 Size
    help: 'Size of the recorded movie. Auto records at the Output Size, and a GIF at most 480 pixels on its longest side. The fractions scale the Output Size down with its shape kept: half the width and height makes about a fifth of the file. Pixels are averaged when scaling, so scanlines and fine patterns do not sparkle.'
  - name: Recordrate
    style: Menu
    label: Frame Rate
    default: auto
    menuNames:
    - auto
    - fps50
    - fps30
    - fps25
    - fps24
    - fps20
    - fps15
    - fps12
    - fps10
    menuLabels:
    - Auto (Project Rate; GIF 20 fps)
    - 50 fps
    - 30 fps
    - 25 fps
    - 24 fps
    - 20 fps
    - 15 fps
    - 12 fps
    - 10 fps
    help: 'Frames per second of the recorded movie. Auto uses the project''s rate, and 20 for a GIF. A lower rate records fewer frames of the same time, with the sound in step: 30 instead of 60 fps made the file about 40% smaller. Never above the project''s rate, and a GIF never above 50, the fastest browsers play.'
  - name: Recordaudio
    style: Toggle
    label: Record Audio
    default: true
    help: Adds the audio input to the movie (AAC; 24-bit uncompressed with ProRes). Off records the picture only. GIFs have no sound.
  - name: Recordfolder
    style: Folder
    label: Recordings Folder
    startSection: true
    default: media/exports
    help: Folder the takes are written to, relative to the project folder unless absolute. Keep it out of git (media/ is ignored in this repo).
  - name: Recordname
    style: Str
    label: Recording Name
    help: File name of each take, before its date and time. Empty uses the project's name.
  - name: Openrecordings
    style: Pulse
    label: Open Recordings Folder
    help: Opens the Recordings Folder in the file browser.
  - name: Recordstatus
    style: Str
    label: Recording
    startSection: true
    readOnly: true
    help: 'What the recorder is doing: the file and length of the take in progress, or the last file saved. Read only.'
  Module:
  - name: Savemodule
    style: Pulse
    label: Save Module
    help: 'Save this deck as the shared module: a clean copy (no bindings to the host, default values) goes to the External .tox Path on the Common page, with readable text versions beside it when Embody is in the project. Every project that loads that .tox picks the change up the next time it opens.'
  - name: Watermark
    style: Toggle
    startSection: true
    default: true
    help: Lays the Watermark Text over the picture, in everything that is shown, shared and recorded. Off leaves the picture untouched.
  - name: Watermarktext
    style: Str
    label: Watermark Text
    default: hyperadapted
    help: The word written over the picture, in Roboto, which ships with TouchDesigner, so it looks the same on Windows and macOS.
  - name: Watermarkopacity
    style: Float
    label: Watermark Opacity
    default: 0.3
    clampMin: true
    clampMax: true
    help: 'How strongly the watermark shows: 0 is invisible, 1 is solid.'
  - name: Watermarkcolor
    style: RGBA
    label: Watermark Color
    size: 3
    default: 1
    help: Colour of the watermark text.
  - name: Watermarksize
    style: Float
    label: Watermark Size
    default: 0.06
    min: 0.01
    max: 0.5
    clampMin: true
    clampMax: true
    normMin: 0.02
    normMax: 0.2
    help: 'Font size as a fraction of the picture height: 0.06 is 6%, so the text keeps its size relative to any Output Format.'
  - name: Watermarkpos
    style: XYZW
    label: Watermark Position
    size: 2
    min: -0.5
    max: 0.5
    clampMin: true
    clampMax: true
    normMin: -0.5
    normMax: 0.5
    help: 'Where the text sits, as an offset from the middle in fractions of the picture: 0, 0 is middle centre; 0.5 moves it to the right (or top) edge and -0.5 to the left (or bottom).'
parameters:
  parentshortcut: OutputDeck
  reloadbuiltin: false
flags:
- viewer
- -allowCooking
color: [0.2, 0.4, 0.3]
tags:
- tdxn_exclude:Outputsize
- tdxn_exclude:Recordstatus
comment: 'Shared module: output framing, Spout/Syphon share and movie recording. Master: ../00-custom-modules/output-deck/output_deck.tox'
operators:
- name: fit_bg
  type: fitTOP
  parameters:
    fit: fitoutside
    resolutionw: =max(2, op('framing').module.RenderSize(parent.OutputDeck)[0] // 8)
    resolutionh: =max(2, op('framing').module.RenderSize(parent.OutputDeck)[1] // 8)
  position: [1200, -400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - null_in
- name: blur_bg
  type: blurTOP
  parameters:
    extend: mirror
    size: 12
  position: [1600, -400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - fit_bg
- name: framing
  type: textDAT
  parameters:
    language: python
  position: [1600, -1400]
- name: null_in
  type: nullTOP
  position: [800, 0]
  inputs:
  - in_video
- name: in_audio
  type: inCHOP
  parameters:
    label: =me.name
    connectorder: 1
    autoexportroot: =parent()
  position: [400, -1400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - const_silence
- name: in_video
  type: inTOP
  parameters:
    label: =me.name
  position: [400, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - const_black
- name: null_out
  type: nullTOP
  position: [3200, 0]
  inputs:
  - comp_watermark
- name: recorder
  type: textDAT
  parameters:
    language: python
  position: [2000, -1400]
- name: movie_out
  type: moviefileoutTOP
  parameters:
    videocodec: h264
    file: media/exports/take.mp4
    moviecontainer: mp4
    audiocodec: aac
    audiobitrate: b192
    fps: 60
  position: [4400, -800]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - res_record
- name: out_video
  type: outTOP
  parameters:
    label: =me.name
  position: [4000, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - null_out
- name: spout_out
  type: syphonspoutoutTOP
  parameters:
    active: =parent.OutputDeck.par.Share
    sendername: =parent.OutputDeck.par.Sendername
  position: [4000, -400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - null_out
- name: switch_bg
  type: switchTOP
  parameters:
    index: =1 if parent.OutputDeck.par.Background == 'blur' else 0
  position: [2000, -400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - const_black
  - blur_bg
- name: deck_clock
  type: executeDAT
  parameters:
    fromop: =parent()
    start: true
    create: true
    frameend: true
  position: [2400, -1400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  tags:
  - tdxn_exclude:dat_content
- name: glsl_frame
  type: glslTOP
  parameters:
    pixeldat: glsl_frame_pixel
    inputextenduv: hold
    premultrgbbyalpha: false
    outputresolution: custom
    resolutionw: =op('framing').module.RenderSize(parent.OutputDeck)[0]
    resolutionh: =op('framing').module.RenderSize(parent.OutputDeck)[1]
    format: rgba8fixed
  sequences:
    color:
    - name: uBack
      rgbr: =parent.OutputDeck.par.Backgroundcolorr
      rgbg: =parent.OutputDeck.par.Backgroundcolorg
      rgbb: =parent.OutputDeck.par.Backgroundcolorb
      alpha: =parent.OutputDeck.par.Backgroundlevel
    vec:
    - name: uFit
      valuex: =parent.OutputDeck.par.Picturefit.menuIndex
      valuey: =parent.OutputDeck.par.Picturezoom
      valuez: =parent.OutputDeck.par.Pictureoffsetx
      valuew: =parent.OutputDeck.par.Pictureoffsety
    - name: uEdge
      valuex: =parent.OutputDeck.par.Softedge
      valuey: =parent.OutputDeck.par.Edgeshape.menuIndex
      valuez: =parent.OutputDeck.par.Blendmode.menuIndex
      valuew: =parent.OutputDeck.par.Background.menuIndex
    - name: uLimit
      valuex: =op('framing').module.LimitScale(parent.OutputDeck)
      valuey: 1
      valuez: 1
      valuew: 1
  position: [2400, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - null_in
  - switch_bg
- name: info_movie
  type: infoCHOP
  parameters:
    op: movie_out
    autoexportroot: =parent()
  position: [4800, -800]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: null_audio
  type: nullCHOP
  parameters:
    autoexportroot: =parent()
  position: [800, -1400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - in_audio
- name: res_record
  type: resolutionTOP
  parameters:
    highqualresize: true
    outputresolution: custom
    resolutionw: 1280
    resolutionh: 720
  position: [4000, -800]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - null_out
- name: const_black
  type: constantTOP
  parameters:
    colorr: 0
    colorg: 0
    colorb: 0
    outputresolution: custom
    resolutionw: 1280
    resolutionh: 720
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: const_silence
  type: constantCHOP
  parameters:
    rate: =me.time.rate
    autoexportroot: =parent()
  sequences:
    const:
    - name: silence
  position: [0, -1400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: comp_watermark
  type: compositeTOP
  parameters:
    operand: over
  position: [2800, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - text_watermark
  - glsl_frame
- name: text_watermark
  type: textTOP
  parameters:
    text: =parent.OutputDeck.par.Watermarktext
    fontfile: =app.samplesFolder + '/Fonts/Roboto-Medium.ttf'
    fontsizex: =parent.OutputDeck.par.Watermarksize * op('framing').module.RenderSize(parent.OutputDeck)[1]
    fontsizexunit: pixels
    positionx: =parent.OutputDeck.par.Watermarkposx
    positiony: =parent.OutputDeck.par.Watermarkposy
    positionunit: fraction
    alignxmode: bbox
    alignymode: bbox
    fontcolorr: =parent.OutputDeck.par.Watermarkcolorr
    fontcolorg: =parent.OutputDeck.par.Watermarkcolorg
    fontcolorb: =parent.OutputDeck.par.Watermarkcolorb
    fontalpha: =parent.OutputDeck.par.Watermarkopacity * parent.OutputDeck.par.Watermark
    outputresolution: custom
    resolutionw: =op('framing').module.RenderSize(parent.OutputDeck)[0]
    resolutionh: =op('framing').module.RenderSize(parent.OutputDeck)[1]
  position: [2400, -400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: glsl_frame_info
  type: infoDAT
  parameters:
    op: glsl_frame
  flags:
  - viewer
  position: [2475, -120]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dock: glsl_frame
  dat_read_only: true
- name: glsl_frame_pixel
  type: textDAT
  parameters:
    language: glsl
    extension: frag
  flags:
  - viewer
  position: [2325, -120]
  dock: glsl_frame
- name: module_callbacks
  type: parameterexecuteDAT
  parameters:
    fromop: =parent()
    op: ..
    pars: Openrecordings Savemodule
    valuechange: false
    builtin: false
  position: [2800, -1400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  tags:
  - tdxn_exclude:dat_content
annotations:
- name: annotate1
  mode: annotate
  title: Picture In and Framing
  text: 'The picture (in_video; black from const_black when nothing is wired) is placed on the output canvas by glsl_frame at the size the Format page asks for (framing: preset, swap, licence limit): fit, zoom and position, the soft edge where it meets the background, the background (solid colour; the picture blurred to cover the canvas through fit_bg -> blur_bg -> switch_bg; mirrored; or transparent) and the blend; comp_watermark lays text_watermark (the Watermark page) over it -> null_out.'
  position: [-70, -470]
  size: [3470, 730]
  color: [0.35, 0.25, 0.45]
  opacity: 0.6
- name: annotate2
  mode: annotate
  title: Share and Record
  text: out_video is the framed picture, for the host. spout_out shares it as a Spout/Syphon sender while Share is on; it cooks itself, so nothing has to pull the deck. res_record scales the picture to the Record Size with High Quality Resize (pixels averaged, so scanlines and fine patterns don't sparkle); movie_out records the takes the recorder sets up, and also cooks itself while recording, so res_record cooks only then. info_movie counts written and repeated frames.
  position: [3930, -870]
  size: [1070, 1130]
  color: [0.45, 0.3, 0.2]
  opacity: 0.6
- name: annotate3
  mode: annotate
  title: Audio In
  text: The audio input (in_audio; silence from const_silence when nothing is wired) -> null_audio, the sound of the recorded movie. An unwired input records no sound.
  position: [-70, -1470]
  size: [1070, 330]
  color: [0.2, 0.35, 0.45]
  opacity: 0.6
- name: annotate4
  mode: annotate
  title: Control
  text: 'framing works out the output size. recorder starts and stops takes: file name, codec with the licence fallback, bit rate, Realtime off for Frame-Exact, Stop After, and Failed when nothing was written. deck_clock runs it at the end of every frame; module_callbacks handles Open Recordings Folder and Save Module.'
  position: [1530, -1470]
  size: [1470, 330]
  color: [0.2, 0.4, 0.3]
  opacity: 0.6
